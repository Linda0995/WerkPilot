<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="WerkPilot.Desktop.Views.ChangePasswordWindow"
        x:DataType="vm:ChangePasswordViewModel"
        xmlns:vm="using:WerkPilot.Desktop.ViewModels"
        Title="WerkPilot – Kennwort ändern"
        Width="500" Height="520"
        CanResize="False"
        WindowStartupLocation="CenterOwner">
  <Grid Background="#F3F6F6">
    <Border Width="390" Padding="30" Background="White" CornerRadius="14"
            HorizontalAlignment="Center" VerticalAlignment="Center">
      <StackPanel Spacing="12">
        <TextBlock FontSize="25" FontWeight="Bold" Foreground="#174F54"
                   Text="Kennwort ändern"/>
        <TextBlock TextWrapping="Wrap"
                   Text="Beim Erststart muss das vorläufige Kennwort ersetzt werden."/>
        <TextBlock Text="Bisheriges Kennwort"/>
        <TextBox PasswordChar="●" Text="{Binding CurrentPassword}"/>
        <TextBlock Text="Neues Kennwort"/>
        <TextBox PasswordChar="●" Text="{Binding NewPassword}"/>
        <TextBlock Text="Neues Kennwort bestätigen"/>
        <TextBox PasswordChar="●" Text="{Binding Confirmation}"/>
        <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="#5A6668"
                   Text="Mindestens 12 Zeichen sowie Groß- und Kleinbuchstaben, Zahl und Sonderzeichen."/>
        <Button Height="42" Content="Kennwort speichern" Command="{Binding SaveCommand}"/>
        <TextBlock TextWrapping="Wrap" Text="{Binding StatusText}"/>
      </StackPanel>
    </Border>
  </Grid>
</Window>
