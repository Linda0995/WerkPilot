<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="WerkPilot.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        xmlns:vm="using:WerkPilot.Desktop.ViewModels"
        Title="WerkPilot 0.13.1 · UI Refresh"
        Width="1500" Height="900"
        MinWidth="1180" MinHeight="720">
  <Grid RowDefinitions="64,*,34" ColumnDefinitions="220,*">
    <Border Grid.Row="0" Grid.ColumnSpan="2" Background="#174F54">
      <Grid ColumnDefinitions="220,*,Auto,Auto,Auto">
        <TextBlock Margin="24,0" VerticalAlignment="Center" FontSize="24"
                   FontWeight="Bold" Foreground="White" Text="WERKPILOT"/>
        <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="18"
                   Foreground="White" Text="Version 0.13.1 · UI Refresh"/>
        <StackPanel Grid.Column="2" Margin="20,0" VerticalAlignment="Center">
          <TextBlock Foreground="White" FontWeight="SemiBold" Text="{Binding SignedInUser}"/>
          <TextBlock Foreground="#CFE4E5" FontSize="11" Text="{Binding SignedInRole}"/>
        </StackPanel>
        <StackPanel Grid.Column="3" Margin="8,7" Spacing="4" Width="390">
          <Button Height="30" Padding="16,2" HorizontalContentAlignment="Left"
                  Content="🔍  Kunden, Angebote, Rechnungen, Projekte, Material suchen …"
                  Command="{Binding OpenGlobalSearchCommand}"/>
          <Button Height="24" Padding="16,1" HorizontalContentAlignment="Left"
                  Content="⚡ Schnellzugriff" Command="{Binding OpenWorkbenchCommand}"/>
        </StackPanel>
        <Button Grid.Column="4" Margin="4,12,16,12" Content="Abmelden"
                Command="{Binding LogoutCommand}"/>
      </Grid>
    </Border>

    <Border Grid.Row="1" Background="#E8EEEE" BorderBrush="#B7C4C5" BorderThickness="0,0,1,0" Padding="12">
      <Grid RowDefinitions="*,Auto">
        <ScrollViewer Grid.Row="0">
          <StackPanel Spacing="6">
          <Button Content="Dashboard" FontWeight="Bold" Foreground="Black" HorizontalContentAlignment="Left" Click="Dashboard_Click"/>
          <Expander Header="Kunden" FontWeight="Bold" Foreground="Black" IsExpanded="True">
            <StackPanel Margin="12,4,0,4" Spacing="4">
              <Button Content="Kundenübersicht" Foreground="Black" HorizontalContentAlignment="Left" Click="Dashboard_Click"/>
              <Button Content="Kundenverlauf" Foreground="Black" HorizontalContentAlignment="Left" Command="{Binding OpenCrmJournalCommand}"/>
              <Button Content="Kundenübersicht 360°" Foreground="Black" HorizontalContentAlignment="Left" Command="{Binding OpenCustomer360Command}"/>
              <Button Content="Wiedervorlagen" Foreground="Black" HorizontalContentAlignment="Left" Command="{Binding OpenCustomerFollowUpsCommand}"/>
            </StackPanel>
          </Expander>
          <Expander Header="Kalkulation &amp; Angebote" FontWeight="Bold" Foreground="Black">
            <StackPanel Margin="12,4,0,4" Spacing="4">
              <Button Content="Kalkulation" Foreground="Black" HorizontalContentAlignment="Left" Command="{Binding OpenCalculationCommand}"/>
              <Button Content="Angebote" Foreground="Black" HorizontalContentAlignment="Left" Command="{Binding OpenOffersCommand}"/>
            </StackPanel>
          </Expander>
          <Expander Header="Projekte" FontWeight="Bold" Foreground="Black">
            <StackPanel Margin="12,4,0,4" Spacing="4">
              <Button Content="Projektübersicht" Foreground="Black" HorizontalContentAlignment="Left" Command="{Binding OpenProjectsCommand}"/>
              <Button Content="Nachkalkulation" Foreground="Black" HorizontalContentAlignment="Left" Command="{Binding OpenProjectCostControllingCommand}"/>
              <Button Content="Meine Arbeit" Foreground="Black" HorizontalContentAlignment="Left" Command="{Binding OpenMyWorkCommand}"/>
              <Button Content="Team-Arbeit" Foreground="Black" HorizontalContentAlignment="Left" Command="{Binding OpenTeamWorkCommand}"/>
            </StackPanel>
          </Expander>
          <Expander Header="Material &amp; Einkauf" FontWeight="Bold" Foreground="Black">
            <StackPanel Margin="12,4,0,4" Spacing="4">
              <Button Content="Material &amp; Preise" Foreground="Black" HorizontalContentAlignment="Left" Command="{Binding OpenMaterialCommand}"/>
              <Button Content="Bestelllisten" Foreground="Black" HorizontalContentAlignment="Left" Command="{Binding OpenPurchaseListsCommand}"/>
              <Button Content="Lager &amp; Inventur" Foreground="Black" HorizontalContentAlignment="Left" Command="{Binding OpenInventoryCommand}"/>
              <Button Content="Inventur" Foreground="Black" HorizontalContentAlignment="Left" Command="{Binding OpenInventoryCountCommand}"/>
              <Button Content="Lieferantenbestellungen" Foreground="Black" HorizontalContentAlignment="Left" Command="{Binding OpenSupplierOrdersCommand}"/>
            </StackPanel>
          </Expander>
          <Expander Header="Finanzen" FontWeight="Bold" Foreground="Black">
            <StackPanel Margin="12,4,0,4" Spacing="4">
              <Button Content="Eingangsrechnungen &amp; Ausgaben" Foreground="Black" HorizontalContentAlignment="Left" Command="{Binding OpenSupplierInvoicesCommand}"/>
              <Button Content="Ausgangsrechnungen &amp; Einnahmen" Foreground="Black" HorizontalContentAlignment="Left" Command="{Binding OpenCustomerInvoicesCommand}"/>
              <Button Content="Offene Forderungen" Foreground="Black" HorizontalContentAlignment="Left" Command="{Binding OpenReceivablesCommand}"/>
              <Button Content="Gutschriften" Foreground="Black" HorizontalContentAlignment="Left" Command="{Binding OpenCustomerCreditNotesCommand}"/>
              <Button Content="Mahnwesen" Foreground="Black" HorizontalContentAlignment="Left" Command="{Binding OpenDunningNoticesCommand}"/>
              <Button Content="Liquiditätsvorschau" Foreground="Black" HorizontalContentAlignment="Left" Command="{Binding OpenSupplierLiquidityCommand}"/>
              <Button Content="Belege" Foreground="Black" HorizontalContentAlignment="Left" Command="{Binding OpenDocumentsCommand}"/>
            </StackPanel>
          </Expander>
          <Expander Header="Organisation" FontWeight="Bold" Foreground="Black">
            <StackPanel Margin="12,4,0,4" Spacing="4">
              <Button Content="Benachrichtigungen" Foreground="Black" HorizontalContentAlignment="Left" Command="{Binding OpenNotificationsCommand}"/>
              <Button Content="Kommunikation" Foreground="Black" HorizontalContentAlignment="Left" Command="{Binding OpenCustomerCommunicationCommand}"/>
              <Button Content="Abwesenheiten" Foreground="Black" HorizontalContentAlignment="Left" Command="{Binding OpenUserAbsencesCommand}"/>
              <Button Content="Aufgabenübergabe" Foreground="Black" HorizontalContentAlignment="Left" Command="{Binding OpenWorkReassignmentCommand}"/>
            </StackPanel>
          </Expander>
          </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="1" Margin="0,10,0,0" Padding="0,10,0,0" BorderBrush="#B7C4C5" BorderThickness="0,1,0,0">
          <Expander Header="⚙ Einstellungen" FontWeight="Bold" Foreground="Black">
            <StackPanel Margin="12,4,0,4" Spacing="4">
              <Button Content="Firmenstammdaten" Foreground="Black" HorizontalContentAlignment="Left" Command="{Binding OpenCompanySettingsCommand}"/>
              <Button Content="Systemdiagnose" Foreground="Black" HorizontalContentAlignment="Left" Command="{Binding OpenReleaseDiagnosticsCommand}"/>
              <Button Content="Erststart-Prüfung" Foreground="Black" HorizontalContentAlignment="Left" Command="{Binding OpenFirstRunReadinessCommand}"/>
            </StackPanel>
          </Expander>
        </Border>
      </Grid>
    </Border>

    <Grid Grid.Row="1" Grid.Column="1">
      <Grid x:Name="DashboardPanel" Margin="24" RowDefinitions="Auto,Auto,Auto,Auto,*">
      <TextBlock FontSize="30" FontWeight="SemiBold" Text="Dashboard &amp; Kunden"/>

      <Grid Grid.Row="1" Margin="0,18,0,18" ColumnDefinitions="*,16,*,16,*,16,*">
        <Border Padding="18" Background="#EAF3F3" CornerRadius="10">
          <StackPanel><TextBlock Text="Aktive Kunden"/><TextBlock FontSize="28" FontWeight="Bold" Text="{Binding CustomerCount}"/></StackPanel>
        </Border>
        <Border Grid.Column="2" Padding="18" Background="#EAF3F3" CornerRadius="10">
          <StackPanel><TextBlock Text="Favoriten"/><TextBlock FontSize="28" FontWeight="Bold" Text="{Binding FavoriteCount}"/></StackPanel>
        </Border>
        <Border Grid.Column="4" Padding="18" Background="#F3F4F5" CornerRadius="10">
          <StackPanel><TextBlock Text="Offene Angebote"/><TextBlock FontSize="28" FontWeight="Bold" Text="{Binding OpenOfferCount}"/><TextBlock FontSize="11" Text="{Binding OpenOfferVolumeNet, StringFormat='Netto {0:N2} €'}"/></StackPanel>
        </Border>
        <Border Grid.Column="6" Padding="18" Background="#F3F4F5" CornerRadius="10">
          <StackPanel><TextBlock Text="Aktive Projekte"/><TextBlock FontSize="28" FontWeight="Bold" Text="{Binding ActiveProjectCount}"/><TextBlock FontSize="11" Text="{Binding OpenProjectTaskCount, StringFormat='Offene Aufgaben: {0}'}"/></StackPanel>
        </Border>
      </Grid>

      <Grid Grid.Row="2" Margin="0,0,0,14" ColumnDefinitions="*,Auto,Auto,20,*,Auto">
        <TextBox Watermark="Name, Nummer, UID, E-Mail, Telefon, Ort oder Kontakt …" Text="{Binding SearchText}"/>
        <Button Grid.Column="1" Margin="8,0,0,0" Content="Suchen" Command="{Binding SearchCommand}"/>
        <CheckBox Grid.Column="2" Margin="14,0,0,0" VerticalAlignment="Center"
                  Content="Papierkorb anzeigen" IsChecked="{Binding IncludeDeleted}"/>
        <TextBox Grid.Column="4" Watermark="Neuer Firmenkunde …" Text="{Binding NewCustomerName}"/>
        <Button Grid.Column="5" Margin="8,0,0,0" Content="Kunde anlegen" Command="{Binding AddCustomerCommand}"/>
      </Grid>

      <Grid Grid.Row="3" Margin="0,0,0,14" ColumnDefinitions="2*,12,2*,12,2*,12,2*">
        <Border Padding="12" Background="#F5F7F7" CornerRadius="8">
          <Grid RowDefinitions="Auto,*">
            <Grid ColumnDefinitions="*,Auto,Auto">
              <TextBlock FontSize="17" FontWeight="SemiBold" Text="Projektaufgaben"/>
              <TextBlock Grid.Column="1" Margin="10,0" Text="{Binding DueTaskCount, StringFormat='Fällig: {0}'}"/>
              <TextBlock Grid.Column="2" FontWeight="Bold" Text="{Binding OverdueTaskCount, StringFormat='Überfällig: {0}'}"/>
            </Grid>
            <DataGrid Grid.Row="1" Margin="0,8,0,0" Height="150"
                      ItemsSource="{Binding DueTasks}" AutoGenerateColumns="False" IsReadOnly="True">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Projekt" Binding="{Binding ProjectNumber}" Width="100"/>
                <DataGridTextColumn Header="Aufgabe" Binding="{Binding TaskTitle}" Width="2*"/>
                <DataGridTextColumn Header="Fällig" Binding="{Binding DueDate}" Width="85"/>
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </Border>

        <Border Grid.Column="2" Padding="12" Background="#FFF4E5" CornerRadius="8">
          <Grid RowDefinitions="Auto,*">
            <Grid ColumnDefinitions="*,Auto,Auto">
              <TextBlock FontSize="17" FontWeight="SemiBold" Text="CRM-Wiedervorlagen"/>
              <TextBlock Grid.Column="1" Margin="10,0"
                         Text="{Binding OpenCrmFollowUpCount, StringFormat='Offen: {0}'}"/>
              <TextBlock Grid.Column="2" FontWeight="Bold"
                         Text="{Binding OverdueCrmFollowUpCount, StringFormat='Überfällig: {0}'}"/>
            </Grid>
            <DataGrid Grid.Row="1" Margin="0,8,0,0" Height="150"
                      ItemsSource="{Binding CrmFollowUps}" AutoGenerateColumns="False" IsReadOnly="True">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Kunde" Binding="{Binding CustomerName}" Width="*"/>
                <DataGridTextColumn Header="Wiedervorlage" Binding="{Binding Subject}" Width="2*"/>
                <DataGridTextColumn Header="Verantwortlich" Binding="{Binding FollowUpOwner}" Width="*"/>
                <DataGridTextColumn Header="Fällig" Binding="{Binding FollowUpDate}" Width="85"/>
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </Border>

        <Border Grid.Column="4" Padding="12" Background="#FCE8E6" CornerRadius="8">
          <Grid RowDefinitions="Auto,*">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto">
              <TextBlock FontSize="17" FontWeight="SemiBold" Text="Kunden-Aufgaben"/>
              <TextBlock Grid.Column="1" Margin="8,0"
                         Text="{Binding DueTodayCustomerFollowUpCount, StringFormat='Heute: {0}'}"/>
              <TextBlock Grid.Column="2" Margin="8,0"
                         FontWeight="Bold"
                         Text="{Binding OverdueCustomerFollowUpCount, StringFormat='Überfällig: {0}'}"/>
              <TextBlock Grid.Column="3"
                         FontWeight="Bold"
                         Text="{Binding UrgentCustomerFollowUpCount, StringFormat='Dringend: {0}'}"/>
            </Grid>
            <DataGrid Grid.Row="1" Margin="0,8,0,0" Height="150"
                      ItemsSource="{Binding CustomerFollowUps}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Kunde" Binding="{Binding CustomerName}" Width="*"/>
                <DataGridTextColumn Header="Aufgabe" Binding="{Binding Title}" Width="2*"/>
                <DataGridTextColumn Header="Prio" Binding="{Binding Priority}" Width="70"/>
                <DataGridTextColumn Header="Fällig" Binding="{Binding DueAtUtc}" Width="120"/>
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </Border>

        <Border Grid.Column="6" Padding="12" Background="#F5F7F7" CornerRadius="8">
          <Grid RowDefinitions="Auto,*">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock FontSize="17" FontWeight="SemiBold" Text="Aktuelle Vorgänge"/>
              <TextBlock Grid.Column="1"
                         Text="{Binding OpenCustomerFollowUpCount, StringFormat='Kunden-Aufgaben offen: {0}'}"/>
            </Grid>
            <DataGrid Grid.Row="1" Margin="0,8,0,0" Height="150"
                      ItemsSource="{Binding RecentItems}" AutoGenerateColumns="False" IsReadOnly="True">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Typ" Binding="{Binding Type}" Width="82"/>
                <DataGridTextColumn Header="Nummer" Binding="{Binding Number}" Width="100"/>
                <DataGridTextColumn Header="Titel" Binding="{Binding Title}" Width="2*"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="85"/>
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </Border>
      </Grid>

      <Grid Grid.Row="4" ColumnDefinitions="5*,18,4*">
        <Border BorderBrush="#D7DEDF" BorderThickness="1" CornerRadius="8" Padding="1">
          <DataGrid ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer}"
                    AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
              <DataGridCheckBoxColumn Header="★" Binding="{Binding IsFavorite}" Width="50"/>
              <DataGridTextColumn Header="Kundennummer" Binding="{Binding CustomerNumber}" Width="145"/>
              <DataGridTextColumn Header="Kunde" Binding="{Binding DisplayName}" Width="2*"/>
              <DataGridTextColumn Header="Ort" Binding="{Binding BillingCity}" Width="*"/>
              <DataGridTextColumn Header="E-Mail" Binding="{Binding Email}" Width="2*"/>
              <DataGridCheckBoxColumn Header="Papierkorb" Binding="{Binding IsDeleted}" Width="90"/>
            </DataGrid.Columns>
          </DataGrid>
        </Border>

        <Border Grid.Column="2" BorderBrush="#D7DEDF" BorderThickness="1" CornerRadius="8" Padding="18">
          <ScrollViewer>
            <StackPanel Spacing="10">
              <TextBlock FontSize="21" FontWeight="SemiBold" Text="Kundendetails"/>
              <TextBlock Text="Firmen-/Kundenname"/>
              <TextBox Text="{Binding EditName}"/>

              <Grid ColumnDefinitions="*,10,*">
                <StackPanel><TextBlock Text="Telefon"/><TextBox Text="{Binding EditPhone}"/></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="E-Mail"/><TextBox Text="{Binding EditEmail}"/></StackPanel>
              </Grid>

              <TextBlock FontWeight="SemiBold" Margin="0,8,0,0" Text="Rechnungsadresse"/>
              <TextBox Watermark="Straße" Text="{Binding BillingStreet}"/>
              <Grid ColumnDefinitions="100,10,*,10,70">
                <TextBox Watermark="PLZ" Text="{Binding BillingPostalCode}"/>
                <TextBox Grid.Column="2" Watermark="Ort" Text="{Binding BillingCity}"/>
                <TextBox Grid.Column="4" Watermark="Land" Text="{Binding BillingCountryCode}"/>
              </Grid>

              <CheckBox Content="Lieferadresse entspricht Rechnungsadresse"
                        IsChecked="{Binding DeliveryEqualsBilling}"/>
              <TextBlock FontWeight="SemiBold" Text="Lieferadresse"/>
              <TextBox Watermark="Straße" Text="{Binding DeliveryStreet}" IsEnabled="{Binding !DeliveryEqualsBilling}"/>
              <Grid ColumnDefinitions="100,10,*,10,70">
                <TextBox Watermark="PLZ" Text="{Binding DeliveryPostalCode}" IsEnabled="{Binding !DeliveryEqualsBilling}"/>
                <TextBox Grid.Column="2" Watermark="Ort" Text="{Binding DeliveryCity}" IsEnabled="{Binding !DeliveryEqualsBilling}"/>
                <TextBox Grid.Column="4" Watermark="Land" Text="{Binding DeliveryCountryCode}" IsEnabled="{Binding !DeliveryEqualsBilling}"/>
              </Grid>

              <Grid ColumnDefinitions="*,10,*">
                <StackPanel>
                  <TextBlock Text="UID/ATU"/>
                  <TextBox Text="{Binding EditVatId}"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="Steuerprofil"/>
                  <ComboBox ItemsSource="{Binding TaxProfiles}" SelectedItem="{Binding EditTaxProfile}"/>
                </StackPanel>
              </Grid>

              <TextBlock Text="Notizen"/>
              <TextBox Text="{Binding EditNotes}" AcceptsReturn="True" MinHeight="70" TextWrapping="Wrap"/>

              <WrapPanel HorizontalAlignment="Right">
                <Button Margin="4" Content="Speichern" Command="{Binding SaveCustomerCommand}"/>
                <Button Margin="4" Content="Favorit" Command="{Binding ToggleFavoriteCommand}"/>
                <Button Margin="4" Content="Papierkorb" Command="{Binding MoveToTrashCommand}"/>
                <Button Margin="4" Content="Wiederherstellen" Command="{Binding RestoreCommand}"/>
              </WrapPanel>

              <Separator Margin="0,10"/>
              <TextBlock FontSize="19" FontWeight="SemiBold" Text="Ansprechpartner"/>
              <DataGrid ItemsSource="{Binding Contacts}" SelectedItem="{Binding SelectedContact}"
                        AutoGenerateColumns="False" IsReadOnly="True" Height="145">
                <DataGrid.Columns>
                  <DataGridCheckBoxColumn Header="Haupt" Binding="{Binding IsPrimary}" Width="60"/>
                  <DataGridTextColumn Header="Bezeichnung" Binding="{Binding Label}" Width="*"/>
                  <DataGridTextColumn Header="E-Mail" Binding="{Binding Email}" Width="2*"/>
                </DataGrid.Columns>
              </DataGrid>

              <TextBox Watermark="Bezeichnung, z. B. Einkauf" Text="{Binding NewContactLabel}"/>
              <Grid ColumnDefinitions="*,10,*">
                <TextBox Watermark="E-Mail" Text="{Binding NewContactEmail}"/>
                <TextBox Grid.Column="2" Watermark="Telefon" Text="{Binding NewContactPhone}"/>
              </Grid>
              <CheckBox Content="Als Hauptansprechpartner anlegen" IsChecked="{Binding NewContactIsPrimary}"/>

              <WrapPanel HorizontalAlignment="Right">
                <Button Margin="4" Content="Hinzufügen" Command="{Binding AddContactCommand}"/>
                <Button Margin="4" Content="Als Hauptkontakt" Command="{Binding SetPrimaryContactCommand}"/>
                <Button Margin="4" Content="Entfernen" Command="{Binding RemoveContactCommand}"/>
              </WrapPanel>

              <Separator Margin="0,10"/>
              <TextBlock FontSize="19" FontWeight="SemiBold" Text="Änderungsverlauf"/>
              <ItemsControl ItemsSource="{Binding History}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Margin="0,3" Padding="8" Background="#F5F7F7" CornerRadius="5">
                      <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="{Binding Action}"/>
                        <TextBlock TextWrapping="Wrap" Text="{Binding Description}"/>
                        <TextBlock FontSize="11" Foreground="#667174" Text="{Binding OccurredAtUtc}"/>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </Border>
      </Grid>
      </Grid>
      <ContentControl x:Name="PageHost" IsVisible="False" Margin="18"/>
    </Grid>

    <Border Grid.Row="2" Grid.ColumnSpan="2" Background="#EEF2F3" Padding="12,0">
      <TextBlock VerticalAlignment="Center" Text="{Binding StatusText}"/>
    </Border>
  </Grid>
</Window>
