<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="WerkPilot.Desktop.Views.UserAbsenceWindow"
        x:DataType="vm:UserAbsenceViewModel"
        xmlns:vm="using:WerkPilot.Desktop.ViewModels"
        Title="WerkPilot 0.12.24 RC – Abwesenheiten und Übergabevorschau"
        Width="1540"
        Height="900">
  <Grid RowDefinitions="64,Auto,*,34">
    <Border Background="#174F54">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Margin="24,0"
                   VerticalAlignment="Center"
                   FontSize="24"
                   FontWeight="Bold"
                   Foreground="White"
                   Text="Abwesenheiten, Konflikte und Vertretung"/>
        <Button Grid.Column="1"
                Margin="0,12,18,12"
                Content="Aktualisieren"
                Command="{Binding RefreshCommand}"/>
      </Grid>
    </Border>

    <Border Grid.Row="1"
            Margin="22,16,22,0"
            Padding="12"
            Background="#EAF3F3"
            CornerRadius="8">
      <Grid ColumnDefinitions="2*,10,*,10,*,10,*,10,2*,10,Auto">
        <ComboBox ItemsSource="{Binding Users}"
                  SelectedItem="{Binding SelectedUser}"
                  DisplayMemberBinding="{Binding DisplayName}"/>
        <ComboBox Grid.Column="2"
                  ItemsSource="{Binding AbsenceTypes}"
                  SelectedItem="{Binding AbsenceType}"/>
        <DatePicker Grid.Column="4"
                    SelectedDate="{Binding StartDate}"/>
        <DatePicker Grid.Column="6"
                    SelectedDate="{Binding EndDate}"/>
        <ComboBox Grid.Column="8"
                  ItemsSource="{Binding Users}"
                  SelectedItem="{Binding SelectedSubstitute}"
                  DisplayMemberBinding="{Binding DisplayName}"/>
        <Button Grid.Column="10"
                Content="Abwesenheit anlegen"
                Command="{Binding CreateCommand}"/>
      </Grid>
    </Border>

    <Grid Grid.Row="2"
          Margin="22,16,22,18"
          ColumnDefinitions="2*,18,4*">
      <DataGrid ItemsSource="{Binding Absences}"
                SelectedItem="{Binding SelectedAbsence}"
                AutoGenerateColumns="False"
                IsReadOnly="True">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Mitarbeiter"
                              Binding="{Binding UserDisplayName}"
                              Width="2*"/>
          <DataGridTextColumn Header="Art"
                              Binding="{Binding Type}"
                              Width="90"/>
          <DataGridTextColumn Header="Von"
                              Binding="{Binding StartDate}"
                              Width="95"/>
          <DataGridTextColumn Header="Bis"
                              Binding="{Binding EndDate}"
                              Width="95"/>
          <DataGridTextColumn Header="Vertretung"
                              Binding="{Binding SubstituteDisplayName}"
                              Width="150"/>
          <DataGridTextColumn Header="Status"
                              Binding="{Binding Status}"
                              Width="90"/>
        </DataGrid.Columns>
      </DataGrid>

      <Grid Grid.Column="2"
            RowDefinitions="Auto,*,Auto">
        <Border Padding="14"
                Background="#F5F7F7"
                CornerRadius="8">
          <StackPanel Spacing="8">
            <TextBlock FontSize="18"
                       FontWeight="SemiBold"
                       Text="Übergabevorschau"/>
            <TextBlock TextWrapping="Wrap"
                       Text="{Binding ConflictText}"/>
          </StackPanel>
        </Border>

        <DataGrid Grid.Row="1"
                  Margin="0,12,0,0"
                  ItemsSource="{Binding AffectedWork}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True">
          <DataGrid.Columns>
            <DataGridCheckBoxColumn Header="Im Zeitraum"
                                    Binding="{Binding DueDuringAbsence}"
                                    Width="85"/>
            <DataGridTextColumn Header="Art"
                                Binding="{Binding TypeText}"
                                Width="105"/>
            <DataGridTextColumn Header="Referenz"
                                Binding="{Binding Reference}"
                                Width="110"/>
            <DataGridTextColumn Header="Kontext"
                                Binding="{Binding Context}"
                                Width="2*"/>
            <DataGridTextColumn Header="Aufgabe"
                                Binding="{Binding Title}"
                                Width="3*"/>
            <DataGridTextColumn Header="Priorität"
                                Binding="{Binding Priority}"
                                Width="85"/>
            <DataGridTextColumn Header="Fällig"
                                Binding="{Binding DueDate}"
                                Width="100"/>
          </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="2"
                Margin="0,12,0,0"
                Padding="14"
                BorderBrush="#D7DEDF"
                BorderThickness="1"
                CornerRadius="8">
          <Grid RowDefinitions="Auto,Auto"
                ColumnDefinitions="*,10,Auto,10,Auto,10,Auto">
            <TextBox Watermark="Übergabegrund, z. B. Urlaub / Vertretung"
                     Text="{Binding TransferReason}"/>
            <Button Grid.Column="2"
                    Content="Nur fällige übergeben"
                    Command="{Binding TransferDueCommand}"/>
            <Button Grid.Column="4"
                    Content="Alle offenen übergeben"
                    Command="{Binding TransferAllCommand}"/>
            <Button Grid.Column="6"
                    Content="Abwesenheit stornieren"
                    Command="{Binding CancelCommand}"/>
            <TextBlock Grid.Row="1"
                       Grid.ColumnSpan="7"
                       Margin="0,10,0,0"
                       TextWrapping="Wrap"
                       Text="Keine automatische Umbuchung: Die Liste ist eine Vorschau. Erst eine der beiden Übergabe-Schaltflächen ändert die Verantwortlichkeit und erzeugt Audit-Einträge."/>
          </Grid>
        </Border>
      </Grid>
    </Grid>

    <Border Grid.Row="3"
            Background="#EEF2F3"
            Padding="12,0">
      <TextBlock VerticalAlignment="Center"
                 Text="{Binding StatusText}"/>
    </Border>
  </Grid>
</Window>
