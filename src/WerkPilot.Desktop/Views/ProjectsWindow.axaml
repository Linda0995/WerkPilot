<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="WerkPilot.Desktop.Views.ProjectsWindow"
        x:DataType="vm:ProjectsViewModel"
        xmlns:vm="using:WerkPilot.Desktop.ViewModels"
        Title="WerkPilot 0.12.24 RC – Projekte"
        Width="1450" Height="880"
        MinWidth="1120" MinHeight="700">
  <Grid RowDefinitions="64,*,34">
    <Border Background="#174F54">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Margin="24,0" VerticalAlignment="Center"
                   FontSize="24" FontWeight="Bold"
                   Foreground="White" Text="Projekte"/>
        <Button Grid.Column="1" Margin="0,12,18,12"
                Content="Aktualisieren"
                Command="{Binding RefreshCommand}"/>
      </Grid>
    </Border>

    <Grid Grid.Row="1" Margin="22"
          RowDefinitions="Auto,*"
          ColumnDefinitions="2*,18,4*">
      <Border Grid.ColumnSpan="3" Padding="14"
              Margin="0,0,0,14"
              Background="#EAF3F3" CornerRadius="10">
        <Grid ColumnDefinitions="2*,10,Auto">
          <ComboBox ItemsSource="{Binding AcceptedOffers}"
                    SelectedItem="{Binding SelectedOffer}"
                    DisplayMemberBinding="{Binding OfferNumber}"/>
          <Button Grid.Column="2"
                  Content="Projekt aus Angebot anlegen"
                  Command="{Binding CreateFromOfferCommand}"/>
        </Grid>
      </Border>

      <DataGrid Grid.Row="1"
                ItemsSource="{Binding Projects}"
                SelectedItem="{Binding SelectedProject}"
                AutoGenerateColumns="False"
                IsReadOnly="True">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Nummer"
                              Binding="{Binding ProjectNumber}"
                              Width="130"/>
          <DataGridTextColumn Header="Projekt"
                              Binding="{Binding Title}"
                              Width="2*"/>
          <DataGridTextColumn Header="Status"
                              Binding="{Binding Status}"
                              Width="100"/>
          <DataGridTextColumn Header="Fortschritt %"
                              Binding="{Binding ProgressPercent}"
                              Width="100"/>
          <DataGridTextColumn Header="Offene Aufgaben"
                              Binding="{Binding OpenTaskCount}"
                              Width="105"/>
        </DataGrid.Columns>
      </DataGrid>

      <Border Grid.Row="1" Grid.Column="2"
              Padding="16"
              BorderBrush="#D7DEDF"
              BorderThickness="1"
              CornerRadius="8">
        <ScrollViewer>
          <StackPanel Spacing="10">
            <TextBlock FontSize="21"
                       FontWeight="SemiBold"
                       Text="Projektdaten"/>

            <TextBox Watermark="Projekttitel"
                     Text="{Binding ProjectTitle}"/>

            <TextBox Watermark="Beschreibung"
                     Text="{Binding ProjectDescription}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     MinHeight="70"/>

            <TextBox Watermark="Projektverantwortlicher"
                     Text="{Binding ProjectManager}"/>

            <Grid ColumnDefinitions="*,10,*">
              <DatePicker SelectedDate="{Binding PlannedStart}"/>
              <DatePicker Grid.Column="2"
                          SelectedDate="{Binding PlannedEnd}"/>
            </Grid>

            <Grid ColumnDefinitions="*,10,Auto,Auto">
              <ComboBox ItemsSource="{Binding ProjectStatuses}"
                        SelectedItem="{Binding ProjectStatus}"/>
              <Button Grid.Column="2" Margin="0,0,6,0"
                      Content="Status übernehmen"
                      Command="{Binding ApplyProjectStatusCommand}"/>
              <Button Grid.Column="3"
                      Content="Projekt speichern"
                      Command="{Binding SaveProjectCommand}"/>
            </Grid>

            <Separator Margin="0,10"/>

            <TextBlock FontSize="20"
                       FontWeight="SemiBold"
                       Text="Aufgaben"/>

            <DataGrid ItemsSource="{Binding Tasks}"
                      SelectedItem="{Binding SelectedTask}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      Height="220">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Pos."
                                    Binding="{Binding PositionNumber}"
                                    Width="55"/>
                <DataGridTextColumn Header="Aufgabe"
                                    Binding="{Binding Title}"
                                    Width="2*"/>
                <DataGridTextColumn Header="Verantwortlich"
                                    Binding="{Binding AssignedTo}"
                                    Width="*"/>
                <DataGridTextColumn Header="Fällig"
                                    Binding="{Binding DueDate}"
                                    Width="95"/>
                <DataGridTextColumn Header="Status"
                                    Binding="{Binding Status}"
                                    Width="100"/>
              </DataGrid.Columns>
            </DataGrid>

            <TextBox Watermark="Aufgabentitel"
                     Text="{Binding TaskTitle}"/>

            <Grid ColumnDefinitions="*,10,150,10,160">
              <ComboBox ItemsSource="{Binding TaskAssignees}"
                        SelectedItem="{Binding SelectedTaskAssignee}"
                        DisplayMemberBinding="{Binding DisplayName}"/>
              <DatePicker Grid.Column="2"
                          SelectedDate="{Binding TaskDueDate}"/>
              <ComboBox Grid.Column="4"
                        ItemsSource="{Binding TaskStatuses}"
                        SelectedItem="{Binding TaskStatus}"/>
            </Grid>

            <WrapPanel HorizontalAlignment="Right">
              <Button Margin="4"
                      Content="Aufgabe hinzufügen"
                      Command="{Binding AddTaskCommand}"/>
              <Button Margin="4"
                      Content="Aufgabe aktualisieren"
                      Command="{Binding UpdateTaskCommand}"/>
              <Button Margin="4"
                      Content="Aufgabe entfernen"
                      Command="{Binding RemoveTaskCommand}"/>
            </WrapPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <Border Grid.Row="2"
            Background="#EEF2F3"
            Padding="12,0">
      <TextBlock VerticalAlignment="Center"
                 Text="{Binding StatusText}"/>
    </Border>
  </Grid>
</Window>
