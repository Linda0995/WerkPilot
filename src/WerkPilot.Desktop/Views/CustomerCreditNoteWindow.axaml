<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="WerkPilot.Desktop.Views.CustomerCreditNoteWindow"
        x:DataType="vm:CustomerCreditNoteViewModel"
        xmlns:vm="using:WerkPilot.Desktop.ViewModels"
        Title="WerkPilot 0.13.2 – Gutschriften"
        Width="1500" Height="900">
  <Grid RowDefinitions="64,*,34">
    <Border Background="#174F54">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Margin="24,0" VerticalAlignment="Center"
                   FontSize="24" FontWeight="Bold" Foreground="White"
                   Text="Gutschriften und Rechnungskorrekturen"/>
        <StackPanel Grid.Column="1" Margin="0,10,18,10"
                    Orientation="Horizontal" Spacing="8">
          <Button Content="PDF-Beleg" Command="{Binding ExportPdfCommand}"/>
          <Button Content="CSV exportieren" Command="{Binding ExportCommand}"/>
          <Button Content="Aktualisieren" Command="{Binding RefreshCommand}"/>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" Margin="22"
          RowDefinitions="Auto,*"
          ColumnDefinitions="2*,18,5*">
      <Border Grid.ColumnSpan="3" Padding="12" Margin="0,0,0,14"
              Background="#EAF3F3" CornerRadius="8">
        <Grid ColumnDefinitions="2*,10,2*,10,140,10,100,10,Auto,10,Auto">
          <ComboBox ItemsSource="{Binding Invoices}"
                    SelectedItem="{Binding SelectedInvoice}"
                    DisplayMemberBinding="{Binding InvoiceNumber}"/>
          <ComboBox Grid.Column="2"
                    ItemsSource="{Binding InvoiceLines}"
                    SelectedItem="{Binding SelectedInvoiceLine}"
                    DisplayMemberBinding="{Binding Description}"/>
          <DatePicker Grid.Column="4" SelectedDate="{Binding CreditNoteDate}"/>
          <NumericUpDown Grid.Column="6" Minimum="0" Increment="1"
                         Value="{Binding Quantity}"/>
          <Button Grid.Column="8" Content="Teilgutschrift"
                  Command="{Binding CreatePartialCommand}"/>
          <Button Grid.Column="10" Content="Vollgutschrift"
                  Command="{Binding CreateFullCommand}"/>
        </Grid>
      </Border>

      <Grid Grid.Row="1" RowDefinitions="Auto,*">
        <TextBox AcceptsReturn="True" MinHeight="80" Margin="0,0,0,10"
                 Watermark="Korrekturgrund" Text="{Binding Reason}"/>
        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding CreditNotes}"
                  SelectedItem="{Binding SelectedCreditNote}"
                  AutoGenerateColumns="False" IsReadOnly="True">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Gutschrift" Binding="{Binding CreditNoteNumber}" Width="120"/>
            <DataGridTextColumn Header="Rechnung" Binding="{Binding CustomerInvoiceNumber}" Width="120"/>
            <DataGridTextColumn Header="Kunde" Binding="{Binding CustomerName}" Width="2*"/>
            <DataGridTextColumn Header="Datum" Binding="{Binding CreditNoteDate}" Width="90"/>
            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
            <DataGridTextColumn Header="Brutto" Binding="{Binding GrossTotal}" Width="100"/>
          </DataGrid.Columns>
        </DataGrid>
      </Grid>

      <Grid Grid.Row="1" Grid.Column="2" RowDefinitions="Auto,Auto,*">
        <Grid ColumnDefinitions="*,Auto,Auto,Auto">
          <TextBlock VerticalAlignment="Center" FontSize="18"
                     FontWeight="SemiBold" Text="Gutschriftpositionen"/>
          <Button Grid.Column="1" Margin="4" Content="Ausstellen"
                  Command="{Binding IssueCommand}"/>
          <Button Grid.Column="2" Margin="4" Content="Mit Rechnung verrechnen"
                  Command="{Binding ApplyCommand}"/>
          <Button Grid.Column="3" Margin="4" Content="Stornieren"
                  Command="{Binding CancelCommand}"/>
        </Grid>

        <Grid Grid.Row="1" Margin="0,8" ColumnDefinitions="*,8,*,8,*">
          <Border Padding="10" Background="#EAF3F3" CornerRadius="6">
            <StackPanel><TextBlock Text="Netto"/><TextBlock FontSize="20" FontWeight="Bold" Text="{Binding SelectedCreditNote.NetTotal, StringFormat='{}{0:N2} €'}"/></StackPanel>
          </Border>
          <Border Grid.Column="2" Padding="10" Background="#F5F7F7" CornerRadius="6">
            <StackPanel><TextBlock Text="Umsatzsteuer"/><TextBlock FontSize="20" FontWeight="Bold" Text="{Binding SelectedCreditNote.VatTotal, StringFormat='{}{0:N2} €'}"/></StackPanel>
          </Border>
          <Border Grid.Column="4" Padding="10" Background="#FFF4E5" CornerRadius="6">
            <StackPanel><TextBlock Text="Brutto"/><TextBlock FontSize="20" FontWeight="Bold" Text="{Binding SelectedCreditNote.GrossTotal, StringFormat='{}{0:N2} €'}"/></StackPanel>
          </Border>
        </Grid>

        <DataGrid Grid.Row="2" ItemsSource="{Binding CreditNoteLines}"
                  AutoGenerateColumns="False" IsReadOnly="True">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Beschreibung" Binding="{Binding Description}" Width="2*"/>
            <DataGridTextColumn Header="Menge" Binding="{Binding Quantity}" Width="80"/>
            <DataGridTextColumn Header="Einheit" Binding="{Binding Unit}" Width="70"/>
            <DataGridTextColumn Header="Preis netto" Binding="{Binding UnitPriceNet}" Width="100"/>
            <DataGridTextColumn Header="USt %" Binding="{Binding VatRatePercent}" Width="70"/>
            <DataGridTextColumn Header="Netto" Binding="{Binding NetTotal}" Width="90"/>
            <DataGridTextColumn Header="Brutto" Binding="{Binding GrossTotal}" Width="90"/>
          </DataGrid.Columns>
        </DataGrid>
      </Grid>
    </Grid>

    <Border Grid.Row="2" Background="#EEF2F3" Padding="12,0">
      <TextBlock VerticalAlignment="Center" Text="{Binding StatusText}"/>
    </Border>
  </Grid>
</Window>
