<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="WerkPilot.Desktop.Views.NotificationsWindow" x:DataType="vm:NotificationsViewModel" xmlns:vm="using:WerkPilot.Desktop.ViewModels" Title="WerkPilot 0.13.2 – Benachrichtigungen" Width="1050" Height="700">
 <Grid RowDefinitions="64,*,34"><Border Background="#174F54"><Grid ColumnDefinitions="*,Auto,Auto"><TextBlock Margin="24,0" VerticalAlignment="Center" FontSize="24" FontWeight="Bold" Foreground="White" Text="Benachrichtigungen"/><TextBlock Grid.Column="1" Margin="12,0" VerticalAlignment="Center" Foreground="White" Text="{Binding UnreadCount, StringFormat='Ungelesen: {0}'}"/><Button Grid.Column="2" Margin="0,12,18,12" Content="Alle als gelesen" Command="{Binding MarkAllReadCommand}"/></Grid></Border>
 <Grid Grid.Row="1" Margin="22" RowDefinitions="Auto,*"><Button HorizontalAlignment="Right" Content="Aktualisieren" Command="{Binding RefreshCommand}"/><DataGrid Grid.Row="1" Margin="0,12,0,0" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridCheckBoxColumn Header="Gelesen" Binding="{Binding IsRead}" Width="70"/><DataGridTextColumn Header="Eskalation" Binding="{Binding Severity}" Width="95"/><DataGridTextColumn Header="Bereich" Binding="{Binding Category}" Width="130"/><DataGridTextColumn Header="Hinweis" Binding="{Binding Title}" Width="2*"/><DataGridTextColumn Header="Beschreibung" Binding="{Binding Description}" Width="2*"/><DataGridTextColumn Header="Fällig" Binding="{Binding DueDate}" Width="95"/></DataGrid.Columns></DataGrid><Button Grid.Row="1" Margin="0,0,12,12" VerticalAlignment="Bottom" HorizontalAlignment="Right" Content="Auswahl als gelesen" Command="{Binding MarkReadCommand}"/></Grid>
 <Border Grid.Row="2" Background="#EEF2F3" Padding="12,0"><TextBlock VerticalAlignment="Center" Text="{Binding StatusText}"/></Border></Grid>
</Window>
