<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="WerkPilot.Desktop.Views.PurchaseListsWindow"
        x:DataType="vm:PurchaseListsViewModel"
        xmlns:vm="using:WerkPilot.Desktop.ViewModels"
        Title="WerkPilot 0.13.2 – Bestelllisten"
        Width="1380" Height="840"
        MinWidth="1080" MinHeight="680">
  <Grid RowDefinitions="64,*,34">
    <Border Background="#174F54">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Margin="24,0" VerticalAlignment="Center" FontSize="24"
                   FontWeight="Bold" Foreground="White"
                   Text="Bestelllisten"/>
        <Button Grid.Column="1" Margin="0,12,18,12"
                Content="Aktualisieren" Command="{Binding RefreshCommand}"/>
      </Grid>
    </Border>

    <Grid Grid.Row="1" Margin="22"
          RowDefinitions="Auto,*"
          ColumnDefinitions="2*,18,4*">
      <Border Grid.ColumnSpan="3" Padding="14" Margin="0,0,0,14"
              Background="#EAF3F3" CornerRadius="10">
        <Grid ColumnDefinitions="2*,10,Auto">
          <ComboBox ItemsSource="{Binding Offers}"
                    SelectedItem="{Binding SelectedOffer}"
                    DisplayMemberBinding="{Binding OfferNumber}"/>
          <Button Grid.Column="2"
                  Content="Bestellliste aus Kalkulation erzeugen"
                  Command="{Binding CreateCommand}"/>
        </Grid>
      </Border>

      <DataGrid Grid.Row="1"
                ItemsSource="{Binding Lists}"
                SelectedItem="{Binding SelectedList}"
                AutoGenerateColumns="False"
                IsReadOnly="True">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Nummer" Binding="{Binding PurchaseListNumber}" Width="135"/>
          <DataGridTextColumn Header="Titel" Binding="{Binding Title}" Width="2*"/>
          <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="105"/>
          <DataGridTextColumn Header="Offen" Binding="{Binding OpenCount}" Width="65"/>
          <DataGridTextColumn Header="Erledigt" Binding="{Binding OrderedCount}" Width="70"/>
        </DataGrid.Columns>
      </DataGrid>

      <Border Grid.Row="1" Grid.Column="2" Padding="16"
              BorderBrush="#D7DEDF" BorderThickness="1" CornerRadius="8">
        <Grid RowDefinitions="Auto,*,Auto,Auto">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock FontSize="20" FontWeight="SemiBold"
                       Text="Bestellpositionen"/>
            <Button Grid.Column="1" Content="CSV exportieren"
                    Command="{Binding ExportCsvCommand}"/>
          </Grid>

          <DataGrid Grid.Row="1" Margin="0,12,0,12"
                    ItemsSource="{Binding Items}"
                    SelectedItem="{Binding SelectedItem}"
                    AutoGenerateColumns="False"
                    IsReadOnly="True">
            <DataGrid.Columns>
              <DataGridCheckBoxColumn Header="Bestellt" Binding="{Binding IsOrdered}" Width="75"/>
              <DataGridTextColumn Header="Lieferant" Binding="{Binding Supplier}" Width="*"/>
              <DataGridTextColumn Header="Artikel" Binding="{Binding ArticleNumber}" Width="110"/>
              <DataGridTextColumn Header="Beschreibung" Binding="{Binding Description}" Width="2*"/>
              <DataGridTextColumn Header="Menge" Binding="{Binding RequiredQuantity}" Width="80"/>
              <DataGridTextColumn Header="Einheit" Binding="{Binding Unit}" Width="65"/>
              <DataGridTextColumn Header="Schätzwert" Binding="{Binding EstimatedTotal}" Width="100"/>
              <DataGridTextColumn Header="Notiz" Binding="{Binding OrderNote}" Width="*"/>
            </DataGrid.Columns>
          </DataGrid>

          <TextBox Grid.Row="2" Watermark="Bestellnotiz, z. B. telefonisch bestellt"
                   Text="{Binding OrderNote}"
                   AcceptsReturn="True"
                   TextWrapping="Wrap"
                   MinHeight="70"/>

          <WrapPanel Grid.Row="3" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Margin="4" Content="Notiz speichern"
                    Command="{Binding SaveNoteCommand}"/>
            <Button Margin="4" Content="Bestellt / wieder offen"
                    Command="{Binding ToggleOrderedCommand}"/>
          </WrapPanel>
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="2" Background="#EEF2F3" Padding="12,0">
      <TextBlock VerticalAlignment="Center" Text="{Binding StatusText}"/>
    </Border>
  </Grid>
</Window>
